# GitHub: read merged PRs (and post PR comments with --comment). `gh auth token` works.
GITHUB_TOKEN=

# Quidli Connect (https://connect.quid.li → Enable API access)
CONNECT_API_KEY=
# CONNECT_API_BASE_URL=https://api.connect.quid.li

# Any OpenAI-compatible chat completions endpoint (OpenAI, OpenRouter, Anthropic's compat endpoint, ...)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=

# Hard rails, enforced in code regardless of what the model says.
# These are in USD and apply to every token: the agent prices the reward token at
# run time and converts. Nothing runs uncapped — no caps, or no price, stops the run.
MAX_BUDGET_USD=100
MAX_PER_RECIPIENT_USD=30
MIN_PER_RECIPIENT_USD=0.10

# Optional per-token override, for a token you'd rather cap by count:
# MAX_BUDGET_BNKR=1000000
# MAX_PER_RECIPIENT_BNKR=400000
# MIN_PER_RECIPIENT_BNKR=1000

# Treasury: Bankr swaps the funding token for the reward token when the agent is short.
BANKR_API_KEY=
# SWAP_BUFFER=1.1        # buy 10% more than needed, to absorb price drift and fees

# Pin a symbol to a contract (skips lookup, and avoids same-symbol collisions)
TOKEN_BNKR=0x22af33fe49fd1fa80c7149773dde5890d3c76f3b
# TOKEN_LIST_URL=https://tokens.coingecko.com/base/all.json

# Dynamic server wallet (only for --payer dynamic)
DYNAMIC_ENVIRONMENT_ID=f0025ac2-8c85-4e85-9d41-48e486cf6c1e
DYNAMIC_AUTH_TOKEN=
WALLET_PASSWORD=
# BASE_RPC_URL=https://mainnet.base.org
# DYNAMIC_BACKUP=false   # only if Dynamic's key-share backup keeps failing; then back up dynamic-shares.json yourself
